{
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "KlabatSync",
        "supportEmail": "support@unklab.ac.id",
        "authorizedRedirectUris": [
          "https://frontend-bbek.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
